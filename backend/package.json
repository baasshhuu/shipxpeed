{
  "name": "fastship-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "dev": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "smoke:delhivery": "tsx --env-file=.env scripts/delhivery-smoke-test.ts",
    "smoke:bigship": "tsx --env-file=.env scripts/bigship-smoke-test.ts",
    "test:rates": "tsx scripts/ratecard-test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.24.0"
  }
}
