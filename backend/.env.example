# Copy to .env and fill in. Never commit .env.

# ---- Server ----
PORT=3000
# Password for the Live login in the panel. Choose a long one.
ADMIN_PASSWORD=
# Random string, 32+ characters, used to sign login sessions.
SESSION_SECRET=
# Where shipments are saved (a JSON file for now; a real database comes later).
DATA_DIR=./data

# ---- Delhivery ----
DELHIVERY_API_TOKEN=
# staging = test servers, production = live. Your token is live, so use production.
DELHIVERY_ENV=production
# Exact, case-sensitive name of your registered Delhivery warehouse
DELHIVERY_PICKUP_LOCATION=
# Required by Delhivery on shipment creation
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_HSN_CODE=
# true = nothing is booked at Delhivery (shipments get DRYRUN-... numbers).
# Set to false only when you are ready for real shipments.
DELHIVERY_DRY_RUN=true

# ---- Bigship (Unified Outbound API). Production only, so keep DRY_RUN=true until tested.
BIGSHIP_USERNAME=
BIGSHIP_PASSWORD=
BIGSHIP_ACCESS_KEY=
BIGSHIP_PICKUP_WAREHOUSE_ID=
BIGSHIP_RETURN_WAREHOUSE_ID=
BIGSHIP_PICKUP_PINCODE=
BIGSHIP_CATEGORY_ID=1
BIGSHIP_DRY_RUN=true
